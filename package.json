{
  "name": "karjmuktbharat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KARJMUKTBHARAT.COM - Karj Se Mukti, Bharat Ki Pragati",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "vite-bundle-visualizer",
    "size": "node scripts/check-bundle-size.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "test:db": "bash scripts/test-db.sh",
    "check:functions": "cd supabase/functions && deno check */index.ts && deno test --allow-env --allow-read _shared",
    "ci": "npm run sync:shared -- --check && npm run lint && npm run typecheck && npm test && npm run build && npm run size"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.18",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lottie-react": "^2.4.2",
    "lucide-react": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.6",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9",
    "workbox-window": "^7.4.1"
  }
}
