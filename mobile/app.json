{
  "expo": {
    "name": "KarjMukt",
    "slug": "karjmuktbharat",
    "scheme": "karjmukt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#000000" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.karjmuktbharat.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock KarjMukt and confirm bank changes with Face ID.",
        "NSCameraUsageDescription": "Scan the QR code on a bank receipt to check its UTR."
      }
    },
    "android": {
      "package": "com.karjmuktbharat.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#000000" },
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"]
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-local-authentication", { "faceIDPermission": "Unlock KarjMukt and confirm bank changes with Face ID." }],
      ["expo-camera", { "cameraPermission": "Scan the QR code on a bank receipt to check its UTR." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
